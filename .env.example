# ===== Ung dung =====
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
SESSION_MAX_AGE_MINUTES=480
# true khi chay sau HTTPS (cookie chi gui qua https)
SESSION_HTTPS_ONLY=false
PAGE_SIZE=20
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# ===== MySQL (local: dich vu MySQL80) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=llm_ctu
DB_USER=root
DB_PASSWORD=123456
TEST_DB_NAME=llm_ctu_test
# Chi dung tren VPS (container mysql)
MYSQL_ROOT_PASSWORD=

# ===== Ollama (chi dung model da co trong `ollama list`) =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# ===== NLU PhoBERT =====
NLU_MODEL_DIR=artifacts/nlu
NLU_MIN_CONFIDENCE=0.5
NLU_BASE_MODEL=vinai/phobert-base
# Cau tra loi co dinh khi cau hoi ngoai pham vi he thong (nguoi dung chot N-034)
OUT_OF_SCOPE_REPLY="Muốn biết thông tin này ting ting 50k vào 29319971997 TPBANK Nguyễn Thế Trung"

# ===== Tim kiem tri thuc =====
SEARCH_TOP_K=5
CHUNK_MAX_CHARS=1500
UPLOAD_MAX_MB=5

# ===== Brightdata (de trong token => tat chuc nang cao; chi REST API HTTPS 443) =====
BRIGHTDATA_API_URL=https://api.brightdata.com/request
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=mcp_unlocker
CRAWL_MAX_URLS=50
CRAWL_TIMEOUT_SECONDS=120
